<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <statusListener class="ch.qos.logback.core.status.OnConsoleStatusListener"/>

    <!-- Variáveis com default -->
    <property name="LOG_DIR" value="${LOG_DIR:-/his/sespct/backend/log}"/>
    <property name="ROOT_LOG_LEVEL" value="${ROOT_LOG_LEVEL:-INFO}"/>
    <property name="APP_LOG_LEVEL" value="${APP_LOG_LEVEL:-DEBUG}"/>

    <!-- Patterns -->
    <property name="PATTERN_COLOR" value="%cyan(%d{HH:mm:ss.SSS}) %gray([%thread]) %highlight(%-5level) %magenta(%logger{36}) - %msg%n"/>
    <property name="PATTERN_FILE"  value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- Appenders -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <withJansi>true</withJansi>
        <encoder><pattern>${PATTERN_COLOR}</pattern></encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/sespct.log</file>
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/sespct.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder><pattern>${PATTERN_FILE}</pattern></encoder>
    </appender>

    <!-- Async wrappers (opcional, mas recomendado) -->
    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="CONSOLE"/>
    </appender>
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE"/>
    </appender>

    <!-- Níveis controlados por variáveis -->
    <logger name="io.micronaut.data.query" level="${APP_LOG_LEVEL}"/>
    <logger name="io.micronaut.data"       level="${APP_LOG_LEVEL}"/>
    <logger name="org.hibernate.SQL"       level="${APP_LOG_LEVEL}"/>
    <!-- ajuste para seu pacote -->
    <logger name="mz.org.csaude"           level="${APP_LOG_LEVEL}"/>
    <logger name="mz.org.fgh"              level="${APP_LOG_LEVEL}"/>
    <logger name="org.openmrs"             level="${APP_LOG_LEVEL}"/>

    <root level="${ROOT_LOG_LEVEL}">
        <appender-ref ref="ASYNC_CONSOLE"/>
        <appender-ref ref="ASYNC_FILE"/>
    </root>
</configuration>
